# Copia este archivo a `.env` y ajusta los valores de tu entorno.

# --- Servidor HTTP ---
HOST=0.0.0.0
PORT=8080
# development | production
APP_ENV=development
# Swagger UI en /docs (vacío = activo salvo en producción)
DOCS_ENABLED=true

# --- Seguridad ---
# Orígenes con acceso CORS: vacío o * = cualquiera (desarrollo).
# En producción, la URL exacta del frontend, separada por comas:
# CORS_ORIGINS=http://localhost:8081,http://192.168.1.50:8081
CORS_ORIGINS=
# Intentos de login fallidos por IP+usuario / ventana en segundos
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW=300
# Tamaño máximo de cualquier cuerpo HTTP (MB)
BODY_MAX_MB=5

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ventas
DB_USER=postgres
DB_PASSWORD=carlos2026
# disable | prefer | require (usa "disable" en local sin SSL)
DB_SSL_MODE=disable
# Tamaño del pool de conexiones
DB_POOL_MAX=10

# --- Asistente IA local (Ollama) ---
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=ventas-qwen2.5-1.5b
MODELOS_DIR=models
CHAT_HF_URL=https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF/resolve/main/qwen2.5-1.5b-instruct-q4_k_m.gguf
CHAT_CONTEXTO=contexto/asistente.md
