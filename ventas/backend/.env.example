# Copia este archivo a `.env` y ajusta los valores de tu entorno.

# --- Servidor HTTP ---
HOST=0.0.0.0
PORT=8080
# development | production
APP_ENV=development
# Swagger UI en /docs (vacío = activo salvo en producción)
DOCS_ENABLED=true

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ventas
DB_USER=postgres
DB_PASSWORD=postgres
# disable | prefer | require (usa "disable" en local sin SSL)
DB_SSL_MODE=disable
# Tamaño del pool de conexiones
DB_POOL_MAX=10

# --- Respaldos (pg_dump) ---
# Carpeta donde se guardan los .dump (relativa al directorio de trabajo:
# desde backend/ los ficheros quedan en backend/backups/)
BACKUPS_DIR=backups
# Ejecutable de pg_dump; si no está en el PATH, la ruta completa del .exe
PG_DUMP_BIN=pg_dump

# --- Asistente IA local (Ollama) ---
# Servidor Ollama (por defecto «ollama serve» escucha aquí)
OLLAMA_URL=http://localhost:11434
# Nombre del modelo que se crea a partir del GGUF
CHAT_MODEL=ventas-qwen2.5-1.5b
# Carpeta de los .gguf descargados (desde backend/ → backend/models/)
MODELOS_DIR=models
# GGUF a descargar de HuggingFace (Qwen2.5-1.5B-Instruct, q4_k_m, ~1 GB)
CHAT_HF_URL=https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF/resolve/main/qwen2.5-1.5b-instruct-q4_k_m.gguf
# Fichero de contexto estático, relee en cada petición (editable sin reiniciar)
CHAT_CONTEXTO=contexto/asistente.md
